;;;
;;;; Zen
;;;


(class Zen extends Jedi-Profile
  
  
  (method override (test self)
    (let ((dir {Directory Home "Devel" "gambit" "app" "latest" "lib"}))
      (iterate-directory dir
        (lambda (path kind)
          (let ((file (new-file dir path)))
            (when (extension=? (get-extension file) "scm")
              (let ((base (get-base file)))
                (when (ends-with? base "#")
                  (call-with-input-file (parse file)
                    (lambda (port)
                      (let ((expr (read port)))
                        (if (and (pair? expr)
                                 (= 2 (length expr))
                                 (eq? (car expr) '##namespace)
                                 (let ((spec (cadr expr)))
                                   (and (string? (car spec))
                                        (every? symbol? (cdr spec)))))
                            #f
                          (unless (or (= 1 (length path))
                                      (equal? (car path) "gambit"))
                            (debug path)))))))))))
        full?: #f
        files?: #t
        directories?: #f
        recursive?: #t))))


(register-profile-class Zen)


(define-expression dependencies
  dialect: scheme
  walk: :keyword))
