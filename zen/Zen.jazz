;; ##top-cte-add-macro-no-dups!
;; couldn't i just used define-runtime-macro
;; and define-runtime-syntax


@could-this-be-used-to-replace-the-ugly-parameterize-around-load-unit!?
(define-runtime-syntax ##this-source-file
  (lambda (src)
    (let ((path (##source-path src)))
      (if path
          (##make-source path (##source-locat src))
          (##raise-expression-parsing-exception
           'unknown-location
           src)))))


