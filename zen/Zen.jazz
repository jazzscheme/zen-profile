;; embrace gambit's module management
;; ##registered-modules and so on


@w
(##debug-modules?-set! #t)

@w
(let ((modref (##parse-module-ref name)))
  (list (macro-modref-host modref) (macro-modref-tag modref) (macro-modref-rpath modref)))

@w
(let ((modref (##parse-module-ref 'foo/goo/baz)))
  (let ((vec (##search-module modref)))
    (##vector mod-dir
              mod-filename-noext
              ext
              mod-path
              port
              root
              path)
    #("/Users/cartier/Devel/zen/app/stable/lib/foo/goo"
      "baz"
      (".zen" . #f)
      "/Users/cartier/Devel/zen/app/stable/lib/foo/goo/baz.zen"
      input-port
      "/Users/cartier/Devel/zen/app/stable/lib"
      ("goo" "foo"))))

@w
(##get-module-search-order)


;; expansion of (import ea)
@w (
(##demand-module ea)
(##namespace ("" (ea ea#ea)))
;; expansion of (define-library (ea) ...)
(##declare (block))
(##supply-module ea)
(##namespace ("ea#"))
(##namespace
 (""
  floor-quotient
  string->uninterned-keyword
  current-directory))
(define ea 45)
(pp ea)
(##namespace (""))
)


