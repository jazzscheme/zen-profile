;;;==============
;;;  JazzScheme
;;;==============
;;;
;;;; Skins
;;;


(data jazz.ide.data.skins


#; ;; dark
(form
  (<Skins-Preferences>                           active: dark
    (<Skin-Preferences> name: dark               title: "Dark" inherit: jazz
      (<Trait>
        (<install>
          (<!>          name: button             background: {Color DM-Dark-Gray})
          (<!>          name: check              text-color: {Color red: .892 green: .773 blue: .290})
          (<!>          name: radio              text-color: {Color red: .892 green: .773 blue: .290})
          (<!>          name: combo              top-padding: 1 text-font: {Font Label-User} arrow-color: {Color red: .892 green: .773 blue: .290} button-border: {Color red: 100 green: 100 blue: 100})
          (<!>          name: label              background: {Color DM-Dark-Gray} text-color: {Color DM-Text-Primary})
          (<!>          name: label/command      background: {Color DM-Dark-Gray} text-color: {Color DM-Text-Primary} text-font: #f)
          (<!>          name: menu               background: {Color DM-Dark-Gray} highlight: {Gradient vertical {Color DM-DarkLight-Gray} {Color DM-Text-Primary}} text-font: {Font Title-User} text-color: {Color DM-Text-Primary} disabled-text-color: {Color red: 133 green: 129 blue: 109} check-mark-white?: #t)
          (<!>          name: tool               highlight:  {Color red: .406 green: .660 blue: .809} active-background: {Color DM-DarkLight-Gray}  inactive-background: {Color DM-DarkLight-Gray} focused-text-color: {Color DM-Text-Primary} )
          (<!>          name: scrollbar          background: {Color Black})
          (<!>          name: scrollbar/tool     background: {Color DM-Dark-Gray})
          (<!>          name: scrollbar/document background: {Color DM-Dark-Gray})
          (<!>          name: splitter           background: {Color DM-Dark-Gray})
          (<!>          name: splitter/document  background: {Color DM-Dark-Gray})
          (<!>          name: docked             background: {Color DM-Dark-Gray} inactive-background: {Color DM-DarkBlue} focused-text-color: {Color DM-Text-Primary} unfocused-text-color: {Color DM-Text-Secondary})
          (<!>          name: stage              background: {Color DM-Dark-Gray})
          (<!>          name: toolbar            background: {Color DM-Dark-Gray})
          (<!>          name: menubar            background: {Gradient vertical {Color DM-DarkMedium-Gray} {Color DM-DarkLight-Gray}} highlight: {Gradient vertical {Color Light-Orange} {Color Orange}})
          (<!>          name: statusbar          background: {Gradient vertical {Color DM-DarkMedium-Gray} {Color DM-DarkLight-Gray}})
          (<!>          name: group              background: {Color DM-Dark-Gray} text-color: {Color DM-DarkLight-Gray} border-flat?: #t)
          (<!>          name: header             background: {Color DM-Dark-Gray} title-color: {Color DM-DarkLight-Gray})
          (<!>          name: header/tool        background: {Color DM-Dark-Gray} title-color: {Color DM-DarkLight-Gray})
          (<!>          name: header/document    background: {Color DM-Dark-Gray} title-color: {Color DM-DarkLight-Gray})
          (<!>          name: tab                background: {Color DM-Dark-Gray})
          (<!>          name: text               background: {Color DM-Dark-Gray} disabled-background: {Color DM-DarkLight-Gray} caret-width: 2 caret-color: {Color red: .706 green: .005 blue: .995} active-selection-color: {Color red: .432 green: .432 blue: .598} inactive-selection-color: {Color Medium-Gray})
          (<!>          name: text/command       background: {Color DM-Dark-Gray} caret-width: 2 caret-color: {Color red: .706 green: .005 blue: .995} base-style: none)
          (<!>          name: tree               background: {Color DM-DarkMedium-Gray} text-color: {Color DM-Text-Primary} line-color: {Color DM-Text-Primary} selected-color: none focused-color: {Color red: 49 green: 106 blue: 197 alpha: .85} unfocused-color: {Color Medium-Gray alpha: .6})
          (<!>          name: color-choose       reticule-color: {Color DM-Text-Primary}))))))

(form
  (<Skins-Preferences>)))
